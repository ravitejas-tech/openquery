"/**
 * Generated by OpenQuery — do not edit.
 *
 * Re-run \`npx openquery generate\` after changing your OpenAPI document.
 */

import { client } from '../../client';
import type {
  ListCommentsVariables,
  ListCommentsResponse,
  GetWidgetsByWidgetIdPartsVariables,
  GetWidgetsByWidgetIdPartsResponse,
  DuplicatedVariables,
  DuplicatedResponse,
  Duplicated2Variables,
  Duplicated2Response,
  DeleteVariables,
  DeleteResponse,
  PingVariables,
  PingResponse,
  OddParamsVariables,
  OddParamsResponse,
  CreateComposedVariables,
  CreateComposedResponse,
  ListFeedVariables,
  ListFeedResponse,
} from './types.js';

/**
 * List comments
 */
export const listComments = () =>
  client.request<ListCommentsResponse>({
    method: 'GET',
    url: '/comments',
  });

/**
 * \`GET /widgets/{widgetId}/parts\`
 */
export const getWidgetsByWidgetIdParts = (
  variables: GetWidgetsByWidgetIdPartsVariables,
) =>
  client.request<GetWidgetsByWidgetIdPartsResponse>({
    method: 'GET',
    url: \`/widgets/\${variables.widgetId}/parts\`,
  });

/**
 * \`GET /dupes/a\`
 */
export const duplicated = () =>
  client.request<DuplicatedResponse>({
    method: 'GET',
    url: '/dupes/a',
  });

/**
 * \`GET /dupes/b\`
 */
export const duplicated2 = () =>
  client.request<Duplicated2Response>({
    method: 'GET',
    url: '/dupes/b',
  });

/**
 * \`GET /reserved\`
 */
export const delete_ = () =>
  client.request<DeleteResponse>({
    method: 'GET',
    url: '/reserved',
  });

/**
 * \`POST /ping\`
 */
export const ping = () =>
  client.request<PingResponse>({
    method: 'POST',
    url: '/ping',
  });

/**
 * \`GET /odd-params\`
 */
export const oddParams = (variables: OddParamsVariables) =>
  client.request<OddParamsResponse>({
    method: 'GET',
    url: '/odd-params',
    params: {
      'filter[status]': variables['filter[status]'],
    },
    headers: {
      'X-Request-Id': variables['X-Request-Id'],
    },
  });

/**
 * \`POST /composed\`
 *
 * Exercises allOf, oneOf, nullable, and enums.
 *
 * @deprecated
 */
export const createComposed = (variables: CreateComposedVariables) =>
  client.request<CreateComposedResponse>({
    method: 'POST',
    url: '/composed',
    data: variables.body,
  });

/**
 * \`GET /feed\`
 */
export const listFeed = (variables: ListFeedVariables) =>
  client.request<ListFeedResponse>({
    method: 'GET',
    url: '/feed',
    params: {
      cursor: variables.cursor,
      limit: variables.limit,
    },
  });
"
`;

