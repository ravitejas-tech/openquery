import { createInfiniteQuery } from 'react-query-kit';
import { listFeed } from './requests.js';
import type { ListFeedVariables, ListFeedResponse } from './types.js';

/**
 * \`GET /feed\`
 */
export const useListFeedInfinite = createInfiniteQuery<
  ListFeedResponse,
  Omit<ListFeedVariables, 'cursor'>,
  Error,
  string | undefined
>({
  queryKey: ['feed'],
  fetcher: (variables, { pageParam }) => listFeed({ ...variables, cursor: pageParam }),
  getNextPageParam: (lastPage) => lastPage?.nextCursor ?? undefined,
  initialPageParam: undefined,
});
"
`;

